\newlabel{fig:training_loss}{{14}{38}{\textbf {Eval Loss Across Training Methods}: 2$\times $2 subplot showing eval loss for all 4 trainer types with independent y-axes (necessary due to vastly different loss scales). \textbf {SFT} (top-left): Loss $\sim $1.5--1.9, Instruct converges lower. \textbf {DPO} (top-right): Loss $\sim $0.21--0.28, smooth convergence. \textbf {CITA} (bottom-left): Loss $\sim $0.27--0.40, NoInstruct converges lower but CITA\_Instruct achieves better reward margins. \textbf {GRPO} (bottom-right): Loss oscillates near zero ($\pm $0.001), characteristic of online RL training dynamics. Note: PPO tensorboard logs were empty (TRL logging issue).\relax }{figure.caption.86}{}}
\newlabel{fig:training_loss@cref}{{[figure][14][2147483647]14}{[1][37][]38}}
