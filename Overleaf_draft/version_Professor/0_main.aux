\newlabel{fig:hp_pareto}{{10}{43}{\textbf {Pareto frontier across trials.} Trial 7 lies on the frontier, achieving near-optimal balance (margin=7.52, accuracy=89\%) while maintaining strong instruction-conditioned switching.\relax }{figure.caption.87}{}}
\newlabel{fig:hp_pareto@cref}{{[figure][10][2147483647]10}{[1][42][]43}}
\newlabel{fig:hp_beta}{{11}{43}{\textbf {$\beta $ sensitivity.} Reward margin peaks at $\beta \approx 0.10$--$0.12$; accuracy is stable (88--90\%), while evaluation loss increases at higher $\beta $, consistent with over-sharpening. Trial 7 ($\star $) at $\beta $=0.107 achieves strong margins while preserving switchability.\relax }{figure.caption.88}{}}
\newlabel{fig:hp_beta@cref}{{[figure][11][2147483647]11}{[1][42][]43}}
\newlabel{fig:hp_lambda}{{12}{44}{\textbf {$\lambda _{\text {KL}}$ sensitivity.} Reward margin exhibits an inverted-U: too low produces instability and regime interference; too high suppresses learning. Accuracy is comparatively stable, indicating the dominant effect is on switching stability rather than raw preference fit. Trial 7 ($\star $) at $\lambda _{\text {KL}}$=0.00023 lies in the optimal band.\relax }{figure.caption.89}{}}
\newlabel{fig:hp_lambda@cref}{{[figure][12][2147483647]12}{[1][42][]44}}
\newlabel{fig:hp_lr}{{13}{45}{\textbf {Learning-rate sensitivity.} Reward margin is highly sensitive to LR, with an optimum near $5\times 10^{-6}$. Higher LR reduces accuracy and increases loss, especially for instruction-augmented sequences. \textbf {Key insight:} \textsc {CITA\_Instruct} requires $\sim $50\% lower LR than standard DPO due to longer contexts and higher gradient variance.\relax }{figure.caption.90}{}}
\newlabel{fig:hp_lr@cref}{{[figure][13][2147483647]13}{[1][42][]45}}
