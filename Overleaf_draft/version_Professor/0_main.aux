\newlabel{fig:hp_ablation_combined}{{15}{32}{\textbf {Hyperparameter Ablation Study}: Reward margin sensitivity to $\beta $, $\lambda _{\text {KL}}$, learning rate, and weight decay across 13 Optuna trials. Trial 7 ($\star $) achieves the best trade-off. \textbf {Key findings}: (a) $\beta \in [0.10, 0.12]$ yields highest margins; (b) $\lambda _{\text {KL}} \approx 0.0002$ balances stability and performance; (c) Learning rate sensitivity is high---$\sim $5e-6 is optimal for instruction-augmented training; (d) Weight decay shows moderate sensitivity with optimal range $\sim $0.01.\relax }{figure.caption.88}{}}
\newlabel{fig:hp_ablation_combined@cref}{{[figure][15][2147483647]15}{[1][31][]32}}
\newlabel{fig:hp_pareto}{{16}{32}{\textbf {Pareto Frontier}: Margin vs. accuracy trade-off across trials. Trial 7 lies on the Pareto frontier, achieving near-optimal balance (margin=7.52, accuracy=89\%).\relax }{figure.caption.89}{}}
\newlabel{fig:hp_pareto@cref}{{[figure][16][2147483647]16}{[1][31][]32}}
\@LN@col{2}
\newlabel{fig:hp_beta}{{17}{33}{\textbf {$\beta $ (DPO Temperature) Sensitivity}: Left: Reward margin peaks at $\beta \approx 0.10$--$0.12$. Middle: Accuracy stable (88--90\%). Right: Eval loss increases with higher $\beta $. Trial 7 ($\star $) at $\beta $=0.107 achieves optimal margin.\relax }{figure.caption.90}{}}
\newlabel{fig:hp_beta@cref}{{[figure][17][2147483647]17}{[1][31][]33}}
\newlabel{fig:hp_lambda}{{18}{34}{\textbf {$\lambda _{\text {KL}}$ (KL Regularization) Sensitivity}: Left: Reward margin shows inverted-U---too low causes instability, too high over-constrains. Middle: Accuracy stable. Right: Eval loss decreases with higher $\lambda $. Trial 7 ($\star $) at $\lambda $=0.00023 hits the sweet spot.\relax }{figure.caption.91}{}}
\newlabel{fig:hp_lambda@cref}{{[figure][18][2147483647]18}{[1][31][]34}}
\newlabel{fig:hp_lr}{{19}{35}{\textbf {Learning Rate Sensitivity}: Reward margin highly sensitive to LR---optimal $\sim $5e-6. Accuracy drops at higher LRs. \textbf {Key insight}: CITA\_Instruct requires $\sim $50\% lower LR than standard DPO due to 30--40\% longer instruction-augmented sequences.\relax }{figure.caption.92}{}}
\newlabel{fig:hp_lr@cref}{{[figure][19][2147483647]19}{[1][31][]35}}
\@LN@col{1}
