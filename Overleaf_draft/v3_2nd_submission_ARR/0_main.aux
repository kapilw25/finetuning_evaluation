\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {Evaluation loss across policy optimization methods.} We plot evaluation loss for DPO, \textsc  {CITA}, and GRPO using independent y-axes due to non-comparable loss scales. \textbf  {DPO (left):} loss $\sim $0.21--0.28 with smooth convergence; the Instruct variant is slightly lower, consistent with stronger preference fit under the instruction-augmented setup. \textbf  {\textsc  {CITA} (center):} loss $\sim $0.27--0.40; the NoInstruct curve converges lower, while \textsc  {CITA\_Instruct} attains larger reward margins, reflecting a separation--stability trade-off induced by the mandatory anchoring term. \textbf  {GRPO (right):} loss oscillates near zero ($\pm $0.001), characteristic of online RL training where the objective is dominated by on-policy sampling variance. \textbf  {Note:} PPO tensorboard logs were empty due to a TRL logging issue, so we do not include PPO curves here.\relax }}{58}{figure.caption.178}\protected@file@percent }
\newlabel{fig:training_loss}{{20}{58}{\textbf {Evaluation loss across policy optimization methods.} We plot evaluation loss for DPO, \textsc {CITA}, and GRPO using independent y-axes due to non-comparable loss scales. \textbf {DPO (left):} loss $\sim $0.21--0.28 with smooth convergence; the Instruct variant is slightly lower, consistent with stronger preference fit under the instruction-augmented setup. \textbf {\textsc {CITA} (center):} loss $\sim $0.27--0.40; the NoInstruct curve converges lower, while \textsc {CITA\_Instruct} attains larger reward margins, reflecting a separation--stability trade-off induced by the mandatory anchoring term. \textbf {GRPO (right):} loss oscillates near zero ($\pm $0.001), characteristic of online RL training where the objective is dominated by on-policy sampling variance. \textbf {Note:} PPO tensorboard logs were empty due to a TRL logging issue, so we do not include PPO curves here.\relax }{figure.caption.178}{}}
\newlabel{fig:training_loss@cref}{{[figure][20][2147483647]20}{[1][57][]58}}
