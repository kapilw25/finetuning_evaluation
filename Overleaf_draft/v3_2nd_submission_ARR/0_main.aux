\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {$\lambda _{\text  {KL}}$ sensitivity.} Reward margin exhibits an inverted-U: too low produces instability and regime interference; too high suppresses learning. Accuracy is comparatively stable, indicating the dominant effect is on switching stability rather than raw preference fit. Trial 7 ($\star $) at $\lambda _{\text  {KL}}$=0.00023 lies in the optimal band.\relax }}{54}{figure.caption.165}\protected@file@percent }
\newlabel{fig:hp_lambda}{{18}{54}{\textbf {$\lambda _{\text {KL}}$ sensitivity.} Reward margin exhibits an inverted-U: too low produces instability and regime interference; too high suppresses learning. Accuracy is comparatively stable, indicating the dominant effect is on switching stability rather than raw preference fit. Trial 7 ($\star $) at $\lambda _{\text {KL}}$=0.00023 lies in the optimal band.\relax }{figure.caption.165}{}}
\newlabel{fig:hp_lambda@cref}{{[figure][18][2147483647]18}{[1][53][]54}}
