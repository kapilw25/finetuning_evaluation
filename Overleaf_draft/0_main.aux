\newlabel{fig:hp_beta}{{16}{31}{\textbf {$\beta $ (DPO Temperature) Sensitivity}: Left: Reward margin peaks at $\beta \approx 0.10$--$0.12$. Middle: Accuracy stable (88--90\%). Right: Eval loss increases with higher $\beta $. Trial 7 ($\star $) at $\beta $=0.107 achieves optimal margin.\relax }{figure.caption.77}{}}
\newlabel{fig:hp_beta@cref}{{[figure][16][2147483647]16}{[1][30][]31}}
\newlabel{fig:hp_lambda}{{17}{32}{\textbf {$\lambda _{\text {KL}}$ (KL Regularization) Sensitivity}: Left: Reward margin shows inverted-U---too low causes instability, too high over-constrains. Middle: Accuracy stable. Right: Eval loss decreases with higher $\lambda $. Trial 7 ($\star $) at $\lambda $=0.00023 hits the sweet spot.\relax }{figure.caption.78}{}}
\newlabel{fig:hp_lambda@cref}{{[figure][17][2147483647]17}{[1][30][]32}}
\newlabel{fig:hp_lr}{{18}{33}{\textbf {Learning Rate Sensitivity}: Reward margin highly sensitive to LR---optimal $\sim $5e-6. Accuracy drops at higher LRs. \textbf {Key insight}: CITA\_Instruct requires $\sim $50\% lower LR than standard DPO due to 30--40\% longer instruction-augmented sequences.\relax }{figure.caption.79}{}}
\newlabel{fig:hp_lr@cref}{{[figure][18][2147483647]18}{[1][30][]33}}
