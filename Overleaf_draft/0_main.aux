\newlabel{fig:conditional_safety@cref}{{[figure][9][]9}{[1][10][]11}}
\newlabel{fig:length_control}{{10}{11}{\textbf {Length Control}: CITA\_Instruct valid-only (1.77) shows strongest adaptation}{figure.caption.40}{}}
\newlabel{fig:length_control@cref}{{[figure][10][]10}{[1][11][]11}}
