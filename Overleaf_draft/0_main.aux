\newlabel{fig:hp_ablation_combined}{{11}{23}{\textbf {Hyperparameter Ablation Study}: Reward margin sensitivity to $\beta $, $\lambda _{\text {KL}}$, learning rate, and weight decay across 13 Optuna trials. Trial 7 ($\star $) achieves the best trade-off. \textbf {Key findings}: (a) $\beta \in [0.10, 0.12]$ yields highest margins; (b) $\lambda _{\text {KL}} \approx 0.0002$ balances stability and performance; (c) Learning rate sensitivity is high---$\sim $5e-6 is optimal for instruction-augmented training; (d) Weight decay shows moderate sensitivity with optimal range $\sim $0.01.\relax }{figure.caption.70}{}}
\newlabel{fig:hp_ablation_combined@cref}{{[figure][11][2147483647]11}{[1][22][]23}}
\newlabel{fig:hp_pareto}{{12}{23}{\textbf {Pareto Frontier}: Margin vs. accuracy trade-off across trials. Trial 7 lies on the Pareto frontier, achieving near-optimal balance (margin=7.52, accuracy=89\%).\relax }{figure.caption.71}{}}
\newlabel{fig:hp_pareto@cref}{{[figure][12][2147483647]12}{[1][22][]23}}
\newlabel{fig:hp_beta}{{13}{24}{\textbf {$\beta $ (DPO Temperature) Sensitivity}: Left: Reward margin peaks at $\beta \approx 0.10$--$0.12$. Middle: Accuracy stable (88--90\%). Right: Eval loss increases with higher $\beta $. Trial 7 ($\star $) at $\beta $=0.107 achieves optimal margin.\relax }{figure.caption.72}{}}
\newlabel{fig:hp_beta@cref}{{[figure][13][2147483647]13}{[1][23][]24}}
\newlabel{fig:hp_lambda}{{14}{24}{\textbf {$\lambda _{\text {KL}}$ (KL Regularization) Sensitivity}: Left: Reward margin shows inverted-U---too low causes instability, too high over-constrains. Middle: Accuracy stable. Right: Eval loss decreases with higher $\lambda $. Trial 7 ($\star $) at $\lambda $=0.00023 hits the sweet spot.\relax }{figure.caption.73}{}}
\newlabel{fig:hp_lambda@cref}{{[figure][14][2147483647]14}{[1][23][]24}}
\newlabel{fig:hp_lr}{{15}{24}{\textbf {Learning Rate Sensitivity}: Reward margin highly sensitive to LR---optimal $\sim $5e-6. Accuracy drops at higher LRs. \textbf {Key insight}: CITA\_Instruct requires $\sim $50\% lower LR than standard DPO due to 30--40\% longer instruction-augmented sequences.\relax }{figure.caption.74}{}}
\newlabel{fig:hp_lr@cref}{{[figure][15][2147483647]15}{[1][23][]24}}
