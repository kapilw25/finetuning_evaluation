\newlabel{tab:beta_ablation}{{26}{27}{Effect of temperature on preference learning. Optimal $\beta \approx 0.1$}{table.caption.73}{}}
\newlabel{tab:beta_ablation@cref}{{[table][26][2147483647]26}{[1][27][]27}}
\newlabel{fig:hp_ablation_combined}{{14}{28}{\textbf {Hyperparameter Ablation Study}: Reward margin sensitivity to $\beta $, $\lambda _{\text {KL}}$, learning rate, and weight decay across 13 Optuna trials. Trial 7 ($\star $) achieves the best trade-off. \textbf {Key findings}: (a) $\beta \in [0.10, 0.12]$ yields highest margins; (b) $\lambda _{\text {KL}} \approx 0.0002$ balances stability and performance; (c) Learning rate sensitivity is high---$\sim $5e-6 is optimal for instruction-augmented training; (d) Weight decay shows moderate sensitivity with optimal range $\sim $0.01}{figure.caption.74}{}}
\newlabel{fig:hp_ablation_combined@cref}{{[figure][14][2147483647]14}{[1][27][]28}}
\newlabel{fig:hp_pareto}{{15}{28}{\textbf {Pareto Frontier}: Margin vs. accuracy trade-off across trials. Trial 7 lies on the Pareto frontier, achieving near-optimal balance (margin=7.52, accuracy=89\%)}{figure.caption.75}{}}
\newlabel{fig:hp_pareto@cref}{{[figure][15][2147483647]15}{[1][27][]28}}
\newlabel{fig:hp_beta}{{16}{29}{\textbf {$\beta $ (DPO Temperature) Sensitivity}: Left: Reward margin peaks at $\beta \approx 0.10$--$0.12$. Middle: Accuracy stable (88--90\%). Right: Eval loss increases with higher $\beta $. Trial 7 ($\star $) at $\beta $=0.107 achieves optimal margin}{figure.caption.76}{}}
\newlabel{fig:hp_beta@cref}{{[figure][16][2147483647]16}{[1][28][]29}}
\newlabel{fig:hp_lambda}{{17}{30}{\textbf {$\lambda _{\text {KL}}$ (KL Regularization) Sensitivity}: Left: Reward margin shows inverted-U---too low causes instability, too high over-constrains. Middle: Accuracy stable. Right: Eval loss decreases with higher $\lambda $. Trial 7 ($\star $) at $\lambda $=0.00023 hits the sweet spot}{figure.caption.77}{}}
\newlabel{fig:hp_lambda@cref}{{[figure][17][2147483647]17}{[1][28][]30}}
\newlabel{fig:hp_lr}{{18}{31}{\textbf {Learning Rate Sensitivity}: Reward margin highly sensitive to LR---optimal $\sim $5e-6. Accuracy drops at higher LRs. \textbf {Key insight}: CITA\_Instruct requires $\sim $50\% lower LR than standard DPO due to 30--40\% longer instruction-augmented sequences}{figure.caption.78}{}}
\newlabel{fig:hp_lr@cref}{{[figure][18][2147483647]18}{[1][28][]31}}
