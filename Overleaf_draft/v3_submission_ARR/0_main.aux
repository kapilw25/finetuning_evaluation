\@writefile{lot}{\contentsline {table}{\numberline {35}{\ignorespaces \textbf  {Benchmark patterns as diagnostics.} Each probe emphasizes a distinct aspect of instruction-conditioned control; the observed method ordering is best read as a \textbf  {multi-axis switching profile}, not a single scalar ``best.''\relax }}{66}{table.caption.245}\protected@file@percent }
\newlabel{tab:tradeoffs}{{35}{66}{\textbf {Benchmark patterns as diagnostics.} Each probe emphasizes a distinct aspect of instruction-conditioned control; the observed method ordering is best read as a \textbf {multi-axis switching profile}, not a single scalar ``best.''\relax }{table.caption.245}{}}
\newlabel{tab:tradeoffs@cref}{{[table][35][2147483647]35}{[1][65][]66}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {$\beta $ sensitivity.} Reward margin peaks at $\beta \approx 0.10$--$0.12$; accuracy is stable (88--90\%), while evaluation loss increases at higher $\beta $, consistent with over-sharpening. Trial 7 ($\star $) at $\beta $=0.107 achieves strong margins while preserving switchability.\relax }}{67}{figure.caption.164}\protected@file@percent }
\newlabel{fig:hp_beta}{{17}{67}{\textbf {$\beta $ sensitivity.} Reward margin peaks at $\beta \approx 0.10$--$0.12$; accuracy is stable (88--90\%), while evaluation loss increases at higher $\beta $, consistent with over-sharpening. Trial 7 ($\star $) at $\beta $=0.107 achieves strong margins while preserving switchability.\relax }{figure.caption.164}{}}
\newlabel{fig:hp_beta@cref}{{[figure][17][2147483647]17}{[1][53][]67}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {$\lambda _{\text  {KL}}$ sensitivity.} Reward margin exhibits an inverted-U: too low produces instability and regime interference; too high suppresses learning. Accuracy is comparatively stable, indicating the dominant effect is on switching stability rather than raw preference fit. Trial 7 ($\star $) at $\lambda _{\text  {KL}}$=0.00023 lies in the optimal band.\relax }}{68}{figure.caption.167}\protected@file@percent }
\newlabel{fig:hp_lambda}{{18}{68}{\textbf {$\lambda _{\text {KL}}$ sensitivity.} Reward margin exhibits an inverted-U: too low produces instability and regime interference; too high suppresses learning. Accuracy is comparatively stable, indicating the dominant effect is on switching stability rather than raw preference fit. Trial 7 ($\star $) at $\lambda _{\text {KL}}$=0.00023 lies in the optimal band.\relax }{figure.caption.167}{}}
\newlabel{fig:hp_lambda@cref}{{[figure][18][2147483647]18}{[1][53][]68}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {Learning-rate sensitivity.} Reward margin is highly sensitive to LR, with an optimum near $5\times 10^{-6}$. Higher LR reduces accuracy and increases loss, especially for instruction-augmented sequences. \textbf  {Key insight:} \textsc  {CITA\_Instruct} requires $\sim $50\% lower LR than standard DPO due to longer contexts and higher gradient variance.\relax }}{69}{figure.caption.171}\protected@file@percent }
\newlabel{fig:hp_lr}{{19}{69}{\textbf {Learning-rate sensitivity.} Reward margin is highly sensitive to LR, with an optimum near $5\times 10^{-6}$. Higher LR reduces accuracy and increases loss, especially for instruction-augmented sequences. \textbf {Key insight:} \textsc {CITA\_Instruct} requires $\sim $50\% lower LR than standard DPO due to longer contexts and higher gradient variance.\relax }{figure.caption.171}{}}
\newlabel{fig:hp_lr@cref}{{[figure][19][2147483647]19}{[1][54][]69}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {Evaluation loss across policy optimization methods.} We plot evaluation loss for DPO, \textsc  {CITA}, and GRPO using independent y-axes due to non-comparable loss scales. \textbf  {DPO (left):} loss $\sim $0.21--0.28 with smooth convergence; the Instruct variant is slightly lower, consistent with stronger preference fit under the instruction-augmented setup. \textbf  {\textsc  {CITA} (center):} loss $\sim $0.27--0.40; the NoInstruct curve converges lower, while \textsc  {CITA\_Instruct} attains larger reward margins, reflecting a separation--stability trade-off induced by the mandatory anchoring term. \textbf  {GRPO (right):} loss oscillates near zero ($\pm $0.001), characteristic of online RL training where the objective is dominated by on-policy sampling variance. \textbf  {Note:} PPO tensorboard logs were empty due to a TRL logging issue, so we do not include PPO curves here.\relax }}{69}{figure.caption.180}\protected@file@percent }
\newlabel{fig:training_loss}{{20}{69}{\textbf {Evaluation loss across policy optimization methods.} We plot evaluation loss for DPO, \textsc {CITA}, and GRPO using independent y-axes due to non-comparable loss scales. \textbf {DPO (left):} loss $\sim $0.21--0.28 with smooth convergence; the Instruct variant is slightly lower, consistent with stronger preference fit under the instruction-augmented setup. \textbf {\textsc {CITA} (center):} loss $\sim $0.27--0.40; the NoInstruct curve converges lower, while \textsc {CITA\_Instruct} attains larger reward margins, reflecting a separation--stability trade-off induced by the mandatory anchoring term. \textbf {GRPO (right):} loss oscillates near zero ($\pm $0.001), characteristic of online RL training where the objective is dominated by on-policy sampling variance. \textbf {Note:} PPO tensorboard logs were empty due to a TRL logging issue, so we do not include PPO curves here.\relax }{figure.caption.180}{}}
\newlabel{fig:training_loss@cref}{{[figure][20][2147483647]20}{[1][56][]69}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces \textbf  {Training accuracy metrics.} Reward accuracy for DPO/\textsc  {CITA} variants. All converge to $\sim $89--92\%, with DPO slightly higher.\relax }}{70}{figure.caption.193}\protected@file@percent }
\newlabel{fig:training_accuracy_appendix}{{21}{70}{\textbf {Training accuracy metrics.} Reward accuracy for DPO/\textsc {CITA} variants. All converge to $\sim $89--92\%, with DPO slightly higher.\relax }{figure.caption.193}{}}
