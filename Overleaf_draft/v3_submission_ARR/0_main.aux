\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {GRPO Training Pipeline.} Unlike PPO, GRPO requires \textbf  {no reference model}---advantages are computed \textbf  {group-relative} within each batch. Starting from a merged SFT checkpoint, the policy $\pi _\theta $ generates $K=6$ responses per prompt. \textbf  {Reward functions} (heuristic): (i) \texttt  {safety\_refusal} (+1.0 for refusing harmful requests), (ii) \texttt  {helpfulness} (+1.0 for substantive responses), (iii) \texttt  {format\_quality} (+0.5 for proper structure). The \textbf  {group-relative advantage} normalizes rewards within the batch: $\hat  {A}(y_i) = (R(y_i) - \mu _{\text  {batch}}) / \sigma _{\text  {batch}}$, enabling policy gradient updates without KL regularization. Output: $\pi _{\text  {GRPO\_NoInstruct}}(Y|X)$ and $\pi _{\text  {GRPO\_Instruct}}(Y|I,X)$.\relax }}{32}{figure.caption.88}\protected@file@percent }
\newlabel{fig:grpo_pipeline}{{12}{32}{\textbf {GRPO Training Pipeline.} Unlike PPO, GRPO requires \textbf {no reference model}---advantages are computed \textbf {group-relative} within each batch. Starting from a merged SFT checkpoint, the policy $\pi _\theta $ generates $K=6$ responses per prompt. \textbf {Reward functions} (heuristic): (i) \texttt {safety\_refusal} (+1.0 for refusing harmful requests), (ii) \texttt {helpfulness} (+1.0 for substantive responses), (iii) \texttt {format\_quality} (+0.5 for proper structure). The \textbf {group-relative advantage} normalizes rewards within the batch: $\hat {A}(y_i) = (R(y_i) - \mu _{\text {batch}}) / \sigma _{\text {batch}}$, enabling policy gradient updates without KL regularization. Output: $\pi _{\text {GRPO\_NoInstruct}}(Y|X)$ and $\pi _{\text {GRPO\_Instruct}}(Y|I,X)$.\relax }{figure.caption.88}{}}
\newlabel{fig:grpo_pipeline@cref}{{[figure][12][2147483647]12}{[1][31][]32}}
