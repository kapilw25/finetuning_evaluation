\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {DPO Training Pipeline.} Starting from a \textbf  {merged SFT checkpoint} (LoRA adapters merged into base weights), the pipeline creates two models: a trainable \textbf  {Policy} $\pi _\theta $ with fresh LoRA adapters (r=16) and a \textbf  {frozen Reference} $\pi _{\text  {ref}}$ (exact copy of merged SFT). PKU-SafeRLHF data undergoes clear contrast filtering (\texttt  {is\_response\_0\_safe} $\neq  $ \texttt  {is\_response\_1\_safe}) to extract preference pairs $(Y^+, Y^-)$ and harm categories. For the \textbf  {Instruct} variant, alignment instructions are synthesized from harm categories and formatted as \texttt  {[sys, user, chosen, rejected]}; for \textbf  {NoInstruct}, the format is \texttt  {[user, chosen, rejected]}. Training uses DPO loss: $\mathcal  {L}_{\text  {DPO}} = -\log \sigma (\beta \cdot \Delta )$ where $\Delta = \text  {margin}_\pi - \text  {margin}_{\text  {ref}}$ and $\beta =0.1$. Output: two trained policies $\pi _{\text  {DPO\_NoInstruct}}(Y|X)$ and $\pi _{\text  {DPO\_Instruct}}(Y|I,X)$.\relax }}{30}{figure.caption.75}\protected@file@percent }
\newlabel{fig:dpo_pipeline}{{10}{30}{\textbf {DPO Training Pipeline.} Starting from a \textbf {merged SFT checkpoint} (LoRA adapters merged into base weights), the pipeline creates two models: a trainable \textbf {Policy} $\pi _\theta $ with fresh LoRA adapters (r=16) and a \textbf {frozen Reference} $\pi _{\text {ref}}$ (exact copy of merged SFT). PKU-SafeRLHF data undergoes clear contrast filtering (\texttt {is\_response\_0\_safe} $\neq $ \texttt {is\_response\_1\_safe}) to extract preference pairs $(Y^+, Y^-)$ and harm categories. For the \textbf {Instruct} variant, alignment instructions are synthesized from harm categories and formatted as \texttt {[sys, user, chosen, rejected]}; for \textbf {NoInstruct}, the format is \texttt {[user, chosen, rejected]}. Training uses DPO loss: $\mathcal {L}_{\text {DPO}} = -\log \sigma (\beta \cdot \Delta )$ where $\Delta = \text {margin}_\pi - \text {margin}_{\text {ref}}$ and $\beta =0.1$. Output: two trained policies $\pi _{\text {DPO\_NoInstruct}}(Y|X)$ and $\pi _{\text {DPO\_Instruct}}(Y|I,X)$.\relax }{figure.caption.75}{}}
\newlabel{fig:dpo_pipeline@cref}{{[figure][10][2147483647]10}{[1][29][]30}}
